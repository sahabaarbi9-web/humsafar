# Humsafar backend environment variables.
# Copy to server/.env (or the project root) and adjust. All values optional —
# sensible local defaults are hard-coded in server/src/config/config.js.

# --- Server ---
PORT=4000
NODE_ENV=development
AUTH_SECRET=change-me-to-a-long-random-string
TOKEN_EXPIRY=7d
REMEMBER_EXPIRY=30d
COOKIE_NAME=humsafar_token
COOKIE_SECURE=false

# --- Database ---
# Absolute or relative to server/. e.g. DATABASE_URL=./data/humsafar.db
# On Vercel this is overridden to /tmp/humsafar-demo.db (ephemeral).
# DATABASE_URL=./data/humsafar.db

# --- Settings ---
MAX_UPLOAD_BYTES=5242880
MAX_PHOTOS=9
MIN_AGE=18
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- URL / CORS ---
APP_URL=http://localhost:4000
CORS_ORIGIN=*

# --- Mail (mock console by default; fill SMTP to send real email) ---
MAIL_FROM=Humsafar <no-reply@humsafar.app>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-username
# SMTP_PASS=your-password
# SMTP_SECURE=false

# --- WebRTC (optional TURN for NAT traversal) ---
RTC_STUN_URL=stun:stun.l.google.com:19302
# RTC_TURN_URL=turn:turn.example.com:3478
# RTC_TURN_USER=user
# RTC_TURN_PASS=pass

# --- Seeding (only used on first run) ---
ADMIN_EMAIL=admin@humsafar.com
ADMIN_PASSWORD=admin123